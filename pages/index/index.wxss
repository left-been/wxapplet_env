.page {
  padding: 20rpx 24rpx 60rpx;
}

.fp-canvas {
  position: fixed;
  top: -9999px;
  left: -9999px;
  width: 160px;
  height: 160px;
  opacity: 0;
  pointer-events: none;
}

.header {
  display: flex;
  align-items: center;
  padding: 16rpx 8rpx 24rpx;
}

.logo {
  position: relative;
  width: 84rpx;
  height: 84rpx;
  border-radius: 22rpx;
  background: linear-gradient(135deg, #07c160, #00aaff);
  display: flex;
  align-items: center;
  justify-content: center;
  box-shadow: 0 6rpx 16rpx rgba(0, 0, 0, 0.15);
  flex-shrink: 0;
}

.logo-ring {
  position: absolute;
  width: 60rpx;
  height: 60rpx;
  border-radius: 50%;
  border: 4rpx solid rgba(255, 255, 255, 0.35);
}

.logo-text {
  position: relative;
  color: #fff;
  font-weight: bold;
  font-size: 22px;
  letter-spacing: 1px;
  text-shadow: 0 1px 2px rgba(0, 0, 0, 0.2);
}

.header-info {
  margin-left: 20rpx;
}

.header-title {
  font-size: 17px;
  font-weight: bold;
  color: #1a1a1a;
}

.header-sub {
  margin-top: 4rpx;
  font-size: 12px;
  color: #999;
}

.fp-card {
  background: #fff;
  border-radius: 16rpx;
  padding: 28rpx;
  margin-bottom: 24rpx;
}

.fp-title {
  font-size: 13px;
  color: #999;
  margin-bottom: 12rpx;
}

.fp-id {
  font-size: 20px;
  font-weight: bold;
  font-family: monospace;
  color: #1a1a1a;
  word-break: break-all;
}

.fp-sub {
  margin-top: 8rpx;
  font-size: 12px;
  color: #999;
}

.fp-actions {
  margin-top: 20rpx;
  display: flex;
  gap: 16rpx;
}

.btn {
  flex: 1;
}

.copy-tip {
  margin-top: 16rpx;
  font-size: 12px;
  color: #07c160;
}

.section {
  background: #fff;
  border-radius: 16rpx;
  margin-bottom: 20rpx;
  overflow: hidden;
}

.section-title {
  font-size: 14px;
  font-weight: bold;
  padding: 20rpx 24rpx;
  border-bottom: 1px solid #f0f0f0;
  background: #fafafa;
}

.row {
  display: flex;
  justify-content: space-between;
  padding: 16rpx 24rpx;
  border-bottom: 1px solid #f5f5f5;
}

.row:last-child {
  border-bottom: none;
}

.row-k {
  color: #888;
  font-size: 13px;
  flex-shrink: 0;
  margin-right: 20rpx;
}

.row-v {
  color: #222;
  font-size: 13px;
  font-family: monospace;
  word-break: break-all;
  text-align: right;
}
